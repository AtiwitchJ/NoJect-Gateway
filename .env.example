# ==============================================================================
# NoJect 🛡️ Agentic AI Security Sentinel & API Gateway - Environment Config
# ==============================================================================
#
# NOTE: The Go gateway reads NO environment variables. Its configuration lives
# entirely in configs/gateway.yaml (server, auth, WAF, audit) plus CLI flags
# (see cmd/gateway/main.go). This file only configures the Agentic AI Sentinel
# (guard-engine/detectors/agentic_sentinel.py and its packages/ equivalents),
# which is the one component that reads env vars.

# Agentic AI Sentinel (LLM-as-a-Judge Configuration)
# Any OpenAI-compatible endpoint works: OpenAI itself, or a local Ollama/vLLM
# server via NOJECT_SENTINEL_BASE_URL below.
NOJECT_SENTINEL_API_KEY=
OPENAI_API_KEY=

# Local / Self-Hosted LLM Sentinel (e.g., Ollama or vLLM)
# NOJECT_SENTINEL_BASE_URL=http://localhost:11434/v1
# NOJECT_SENTINEL_MODEL=llama3.3:70b
