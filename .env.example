# ==============================================================================
# NoJect 🛡️ Agentic AI Security Sentinel & API Gateway - Environment Config
# ==============================================================================

# Server & Gateway Settings
NOJECT_PORT=8080
NOJECT_HOST=0.0.0.0
NOJECT_ENV=development
NOJECT_LOG_LEVEL=info

# Python AI Guard Engine Service
NOJECT_GUARD_ENGINE_URL=http://localhost:8000
NOJECT_GUARD_TIMEOUT_MS=500

# Agentic AI Sentinel (LLM-as-a-Judge Configuration)
# Optional: Set your OpenAI, Anthropic, Gemini, or Local vLLM/Ollama API Key
NOJECT_SENTINEL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Local / Self-Hosted LLM Sentinel URL (e.g., Ollama or vLLM)
# NOJECT_SENTINEL_BASE_URL=http://localhost:11434/v1
# NOJECT_SENTINEL_MODEL=llama3.3:70b

# Security & Multi-Auth
NOJECT_ADMIN_API_KEY=nj_admin_supersecretkey12345
NOJECT_JWT_SECRET=your-256-bit-secret-for-jwt-signing
NOJECT_HMAC_SECRET=your-shared-secret-for-m2m-signatures

# Cryptographic Audit Trail (ISO/IEC 27001)
NOJECT_AUDIT_LOG_FILE=logs/audit_trail.log
NOJECT_AUDIT_HASH_ALGO=SHA-256

# Sensitive PII Masking (ISO/IEC 42001)
NOJECT_PII_MASKING_ENABLED=true
NOJECT_CANARY_SHIELD_ENABLED=true
